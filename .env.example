# ==============================================================================
# ExceptionOps Environment Configuration
# ==============================================================================
# NOTE: By default, ExceptionOps runs 100% offline with zero configuration using
# the built-in MockLLM. Set any of the providers below to use live models.
# ==============================================================================

# --- LLM Provider Selection (Optional) ---
# Choices: "groq", "azure", "openai", "anthropic", "mock" (auto-detected if blank)
LLM_PROVIDER=

# --- Option 0: Groq (Ultra-fast Inference) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Option 1: Azure OpenAI (Recommended for enterprise) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Option 2: OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Option 3: Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Operational Governance & Guardrails ---
# Maximum dollar threshold before human operator review is mandated
COST_APPROVAL_THRESHOLD=200.0

# --- Frontend Dashboard (dashboard/.env) ---
# Only needed if backend is hosted on a remote server/custom port
# VITE_API_URL=http://localhost:8000

